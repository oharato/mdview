#!/usr/bin/env python3
"""mdview — mdcat で Markdown を表示しつつ、画像と Mermaid を端末内に描画する。

mdcat 本体は kitty / iTerm2 / Terminology 系の画像プロトコルしか扱えず、
Windows Terminal や SSH 越しの端末では画像が出ない。mdview は
  * ```mermaid フェンスを Pele で SVG 化 → resvg でラスタライズ（Chrome 不要）
  * ![](画像) を読み込み
  * Sixel（Windows Terminal 1.22+ など）または ANSI トゥルーカラー半ブロックで描画
して、テキスト部分だけ mdcat に渡す。

Sixel の表示サイズは端末に CSI 16t / 14t を問い合わせて実ピクセルで合わせる。
取得できない端末では --pixel-scale / MDVIEW_CELL で補正する。

使い方:
  mdview README.md
  cat README.md | mdview
  mdview -w 100 --image-width 100 --renderer sixel doc.md
  mdview --check        # 端末の対応状況を表示
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import select
import shutil
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path

CACHE_DIR = Path(os.environ.get("MDVIEW_CACHE", Path.home() / ".cache" / "mdview"))
SENTINEL_TMPL = "@@mdview-image-{}-@@"
SENTINEL_RE = re.compile(r"^@@mdview-image-(\d+)-@@[ \t]*$")
IMAGE_RE = re.compile(
    r"!\[(?P<alt>[^\]]*)\]\(\s*<?(?P<src>[^)>\s]+)>?"
    r"(?:\s+(?P<title>\"[^\"]*\"|'[^']*'))?\s*\)"
)
FENCE_RE = re.compile(r"^(?P<indent>[ \t]*)(?P<fence>`{3,}|~{3,})[ \t]*mermaid\b(?P<info>.*)$")

DIM = "\x1b[2m"
RESET = "\x1b[0m"
VERSION = "0.1.0"
SIXEL_TRANSLATE = bytes(min(255, 63 + i) for i in range(256))


def warn(msg: str) -> None:
    print(f"{DIM}[mdview] {msg}{RESET}", file=sys.stderr)


def die(msg: str, code: int = 1) -> None:
    print(f"mdview: {msg}", file=sys.stderr)
    raise SystemExit(code)


# --------------------------------------------------------------------------
# 端末ケーパビリティ
# --------------------------------------------------------------------------
_PROBE: dict[str, object] | None = None


def _tty_io():
    """読み書きできる端末 fd を返す（stdin が tty でなければ /dev/tty）。"""
    try:
        if sys.stdin.isatty():
            return sys.stdin.fileno(), False
    except (AttributeError, ValueError):
        pass
    try:
        return os.open("/dev/tty", os.O_RDWR | os.O_NOCTTY), True
    except OSError:
        return None, False


def probe_terminal() -> dict[str, object]:
    """DA1 と XTWINOPS (CSI 16t / 14t) をまとめて問い合わせる。

    - sixel: 端末が Sixel 描画に対応しているか (None = 判定不能)
    - cell : (文字幅px, 文字高px)
    - window: (幅px, 高px)
    """
    global _PROBE
    if _PROBE is not None:
        return _PROBE

    result: dict[str, object] = {"sixel": None, "cell": None, "window": None}
    fd, close_fd = _tty_io()
    if fd is None:
        _PROBE = result
        return result

    try:
        import termios
        import tty
    except ImportError:
        _PROBE = result
        return result

    old = None
    resp = b""
    try:
        old = termios.tcgetattr(fd)
        tty.setraw(fd)
        os.write(fd, b"\x1b[c\x1b[16t\x1b[14t")
        while True:
            r, _, _ = select.select([fd], [], [], 0.3)
            if not r:
                break
            chunk = os.read(fd, 512)
            if not chunk:
                break
            resp += chunk
            if resp.count(b"c") and resp.count(b"t") >= 2:
                break
    except (OSError, termios.error):
        resp = b""
    finally:
        if old is not None:
            try:
                termios.tcsetattr(fd, termios.TCSADRAIN, old)
            except (OSError, termios.error):
                pass
        if close_fd:
            try:
                os.close(fd)
            except OSError:
                pass

    m = re.search(rb"\x1b\[\?([0-9;]+)c", resp)
    if m:
        result["sixel"] = "4" in m.group(1).decode().split(";")
    mc = re.search(rb"\x1b\[6;(\d+);(\d+)t", resp)
    if mc:
        h, w = int(mc.group(1)), int(mc.group(2))
        if w > 0 and h > 0:
            result["cell"] = (w, h)
    mw = re.search(rb"\x1b\[4;(\d+);(\d+)t", resp)
    if mw:
        h, w = int(mw.group(1)), int(mw.group(2))
        if w > 0 and h > 0:
            result["window"] = (w, h)
    _PROBE = result
    return result


def caps_key() -> str:
    return "|".join(
        os.environ.get(k, "")
        for k in ("TERM", "TERM_PROGRAM", "TERM_PROGRAM_VERSION", "SSH_CONNECTION")
    )


def sixel_supported(refresh: bool = False) -> bool:
    override = os.environ.get("MDVIEW_SIXEL")
    if override is not None:
        return override not in ("", "0", "false", "no")
    cache_file = CACHE_DIR / "caps.json"
    try:
        cache = json.loads(cache_file.read_text())
    except (OSError, ValueError):
        cache = {}
    key = caps_key()
    if not refresh and key in cache:
        return bool(cache[key])
    ok = probe_terminal()["sixel"]
    if ok is None:  # 判定不能なら Sixel は使わない
        return False
    try:
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        cache[key] = ok
        cache_file.write_text(json.dumps(cache, indent=0))
    except OSError:
        pass
    return bool(ok)


def cell_pixels() -> tuple[int, int]:
    """文字セルの実ピクセルサイズを返す（Sixel の表示サイズ計算に使う）。"""
    override = os.environ.get("MDVIEW_CELL", "") or ""
    m = re.fullmatch(r"(\d+)\s*[xX,]\s*(\d+)", override)
    if m:
        return int(m.group(1)), int(m.group(2))

    cell = probe_terminal()["cell"]
    if cell:
        return cell  # type: ignore[return-value]

    # フォールバック: TIOCGWINSZ のピクセル情報
    try:
        import fcntl
        import struct
        import termios

        fd, close_fd = _tty_io()
        if fd is not None:
            data = fcntl.ioctl(fd, termios.TIOCGWINSZ, b"\0" * 8)
            rows, cols, xpix, ypix = struct.unpack("HHHH", data)
            if close_fd:
                os.close(fd)
            if xpix and cols:
                return max(1, xpix // cols), max(1, ypix // rows) if rows else 18
    except (OSError, ImportError, ValueError):
        pass
    return 9, 18  # 最後の手段（Windows Terminal + 100% スケーリング相当）


# --------------------------------------------------------------------------
# Markdown 前処理
# --------------------------------------------------------------------------
def extract_mermaid(text: str):
    """mermaid フェンスを取り出して sentinel 行に置き換える。"""
    out_lines: list[str] = []
    blocks: list[tuple[str, str]] = []
    lines = text.splitlines(keepends=True)
    i = 0
    while i < len(lines):
        m = FENCE_RE.match(lines[i].rstrip("\n"))
        if not m:
            out_lines.append(lines[i])
            i += 1
            continue
        fence = m.group("fence")
        close_re = re.compile(r"^[ \t]*" + re.escape(fence[0]) + "{" + str(len(fence)) + r",}[ \t]*$")
        body: list[str] = []
        i += 1
        while i < len(lines) and not close_re.match(lines[i].rstrip("\n")):
            body.append(lines[i])
            i += 1
        i += 1  # 閉じフェンス
        out_lines.append(f"\n{SENTINEL_TMPL.format(len(blocks))}\n\n")
        blocks.append(("".join(body), m.group("info").strip()))
    return "".join(out_lines), blocks


def extract_images(text: str, offset: int = 0):
    """単独行の画像記法を sentinel 行に置き換える（文中のインライン画像は残す）。"""
    out_lines: list[str] = []
    blocks: list[tuple[str, str]] = []
    for line in text.splitlines(keepends=True):
        m = IMAGE_RE.fullmatch(line.strip())
        if m:
            out_lines.append(f"\n{SENTINEL_TMPL.format(offset + len(blocks))}\n\n")
            blocks.append((m.group("src"), m.group("alt")))
        else:
            out_lines.append(line)
    return "".join(out_lines), blocks


def process_document(text: str, base_dir: Path, args) -> None:
    text, mermaid_blocks = extract_mermaid(text)
    text, image_blocks = extract_images(text, offset=len(mermaid_blocks))

    assets: list[tuple[str, tuple]] = [("mermaid", b) for b in mermaid_blocks]
    assets += [("image", b) for b in image_blocks]

    chunks: list[tuple[str, object]] = []
    buf: list[str] = []
    for line in text.splitlines(keepends=True):
        m = SENTINEL_RE.match(line.rstrip("\n"))
        if m:
            if "".join(buf).strip():
                chunks.append(("text", "".join(buf)))
            buf = []
            chunks.append(("asset", int(m.group(1))))
        else:
            buf.append(line)
    if "".join(buf).strip():
        chunks.append(("text", "".join(buf)))

    for kind, payload in chunks:
        if kind == "text":
            render_text(payload, args)
            continue
        what, item = assets[payload]
        if what == "mermaid":
            render_mermaid(*item, args=args)
        else:
            render_image(*item, base_dir=base_dir, args=args)


def render_text(chunk: str, args) -> None:
    mdcat = shutil.which("mdcat")
    if not mdcat:
        sys.stdout.write(chunk)
        return
    sys.stdout.flush()
    cmd = [mdcat, "--columns", str(args.width)]
    if args.no_colour:
        cmd.append("--no-colour")
    else:
        cmd.append("--ansi")
    res = subprocess.run(cmd, input=chunk, text=True)
    if res.returncode != 0:
        sys.stdout.write(chunk)


# --------------------------------------------------------------------------
# Mermaid
# --------------------------------------------------------------------------
def find_chrome() -> str | None:
    env = os.environ.get("PUPPETEER_EXECUTABLE_PATH")
    if env and Path(env).exists():
        return env
    cache = Path.home() / ".cache" / "puppeteer"
    if cache.is_dir():
        hits = sorted(cache.glob("chrome-headless-shell/*/chrome-headless-shell-linux64/chrome-headless-shell"))
        if hits:
            return str(hits[-1])
        hits = sorted(cache.glob("chrome/*/chrome-linux64/chrome"))
        if hits:
            return str(hits[-1])
    for cand in ("chromium", "chromium-browser", "google-chrome", "google-chrome-stable"):
        p = shutil.which(cand)
        if p:
            return p
    return None


def puppeteer_config() -> Path:
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    cfg = CACHE_DIR / "puppeteer.json"
    if not cfg.exists():
        cfg.write_text('{"args":["--no-sandbox","--disable-dev-shm-usage","--disable-gpu"]}\n')
    return cfg


def pele_helper() -> Path | None:
    """Pele のレンダリングスクリプト（node から 'pele' を import する）。"""
    here = Path(__file__).resolve().parent
    candidates = [
        os.environ.get("MDVIEW_PELE", ""),
        str(here / "pele" / "render.mjs"),
        str(Path.home() / ".local/share/mdview/pele/render.mjs"),
    ]
    for cand in candidates:
        if cand and Path(cand).exists():
            return Path(cand) if shutil.which("node") else None
    return None


def find_resvg() -> str | None:
    for cand in (os.environ.get("MDVIEW_RESVG"), str(Path.home() / ".local/bin/resvg")):
        if cand and Path(cand).exists():
            return cand
    return shutil.which("resvg")


def mermaid_theme(args) -> str:
    theme = args.mermaid_theme
    if theme == "auto":
        theme = "default" if args.light_background else "dark"
    return theme


def rasterize_svg(svg_path: Path, png_path: Path, width: int) -> bool:
    """SVG を PNG 化する。resvg があれば使い、無ければ Chrome にフォールバック。"""
    resvg = find_resvg()
    if resvg:
        res = subprocess.run(
            [resvg, "--width", str(width), str(svg_path), str(png_path)],
            capture_output=True, text=True,
        )
        if png_path.exists():
            return True
        warn(f"resvg で変換できませんでした: {(res.stderr or '').strip().splitlines()[:1]}")

    chrome = find_chrome()
    if not chrome:
        return False
    try:
        subprocess.run(
            [chrome, "--headless", "--disable-gpu", "--no-sandbox", "--hide-scrollbars",
             "--default-background-color=00000000", f"--window-size={width},2000",
             f"--screenshot={png_path}", svg_path.resolve().as_uri()],
            capture_output=True, timeout=60,
        )
    except subprocess.TimeoutExpired:
        return False
    if not png_path.exists():
        return False
    try:
        from PIL import Image

        with Image.open(png_path) as im:
            img = im.convert("RGBA")
            box = img.getbbox()
            if box:
                img = img.crop(box)
            img.save(png_path)
    except Exception:  # noqa: BLE001
        return False
    return True


def render_mermaid(code: str, info: str, args) -> None:
    """Mermaid を Pele で SVG 化 → resvg で PNG 化（Pele が無ければ mermaid-cli）。"""
    theme = mermaid_theme(args)
    key = hashlib.sha256(
        f"{code}\x00{theme}\x00{args.mermaid_config}\x00{args.mermaid_engine}".encode()
    ).hexdigest()[:16]
    out_dir = CACHE_DIR / "mermaid"
    out_dir.mkdir(parents=True, exist_ok=True)
    png = out_dir / f"{key}.png"

    if png.exists():
        show_image(png, "mermaid", args)
        return

    helper = pele_helper() if args.mermaid_engine in ("auto", "pele") else None
    if helper:
        svg = None
        failed = False
        try:
            proc = subprocess.run(
                ["node", str(helper), theme], input=code, capture_output=True,
                text=True, timeout=args.mermaid_timeout,
            )
            if proc.returncode == 0 and proc.stdout.lstrip().startswith("<svg"):
                svg = proc.stdout
            else:
                failed = True
                detail = (proc.stderr or proc.stdout).strip().splitlines()
                warn("Mermaid を描画できません: " + (detail[-1] if detail else "unknown error"))
        except subprocess.TimeoutExpired:
            failed = True
            warn("Mermaid のレンダリングがタイムアウトしました")
        if svg:
            svg_path = out_dir / f"{key}.svg"
            svg_path.write_text(svg)
            if not rasterize_svg(svg_path, png, args.mermaid_width):
                warn("SVG のラスタライズに失敗しました")
            try:
                svg_path.unlink()
            except OSError:
                pass
        if png.exists():
            show_image(png, "mermaid", args)
            return
        if failed or args.mermaid_engine == "pele":
            render_text("```mermaid\n" + code + "```\n", args)
            return

    # フォールバック: mermaid-cli (Chrome が必要)
    mmdc = shutil.which("mmdc")
    if not mmdc:
        warn("Pele / resvg も mermaid-cli も使えないため、コードブロックとして表示します")
        render_text("```mermaid\n" + code + "```\n", args)
        return
    src = out_dir / f"{key}.mmd"
    src.write_text(code if code.endswith("\n") else code + "\n")
    cmd = [
        mmdc, "-i", str(src), "-o", str(png),
        "-p", str(puppeteer_config()),
        "-t", "dark" if theme == "dark" else "default",
        "-b", "transparent", "-s", "3",
    ]
    if args.mermaid_config:
        cmd += ["-c", args.mermaid_config]
    env = dict(os.environ)
    chrome = find_chrome()
    if chrome:
        env.setdefault("PUPPETEER_EXECUTABLE_PATH", chrome)
    try:
        res = subprocess.run(cmd, capture_output=True, text=True, env=env,
                             timeout=args.mermaid_timeout)
    except subprocess.TimeoutExpired:
        warn("Mermaid のレンダリングがタイムアウトしました")
        render_text("```mermaid\n" + code + "```\n", args)
        return
    if res.returncode != 0 or not png.exists():
        detail = (res.stderr or res.stdout).strip().splitlines()
        warn("Mermaid のレンダリングに失敗: " + (detail[-1] if detail else "unknown error"))
        render_text("```mermaid\n" + code + "```\n", args)
        return
    try:
        src.unlink()
    except OSError:
        pass
    show_image(png, "mermaid", args)


