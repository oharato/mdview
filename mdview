# 画像
# --------------------------------------------------------------------------
def resolve_source(src: str, base_dir: Path) -> Path | None:
    if re.match(r"^https?://", src, re.I):
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        name = hashlib.sha256(src.encode()).hexdigest()[:16]
        ext = Path(src.split("?")[0]).suffix or ".img"
        dest = CACHE_DIR / "remote" / f"{name}{ext}"
        if dest.exists():
            return dest
        dest.parent.mkdir(parents=True, exist_ok=True)
        req = urllib.request.Request(src, headers={"User-Agent": "mdview/1.0"})
        try:
            with urllib.request.urlopen(req, timeout=30) as r, open(dest, "wb") as f:
                shutil.copyfileobj(r, f)
        except (urllib.error.URLError, OSError, TimeoutError) as e:
            warn(f"画像の取得に失敗: {src} ({e})")
            return None
        return dest
    p = Path(os.path.expanduser(src))
    if not p.is_absolute():
        p = base_dir / p
    if not p.exists():
        warn(f"画像が見つかりません: {src}")
        return None
    return p


def render_image(src: str, alt: str, base_dir: Path, args) -> None:
    path = resolve_source(src, base_dir)
    if path is None:
        print(f"{DIM}[画像: {alt or src}]{RESET}", flush=True)
        return
    show_image(path, alt, args)


def background_colour(args) -> tuple[int, int, int] | None:
    if args.image_bg == "none":
        return None
    if args.image_bg == "auto":
        return (255, 255, 255) if args.light_background else (12, 12, 12)
    v = args.image_bg.lstrip("#")
    if len(v) == 3:
        v = "".join(ch * 2 for ch in v)
    try:
        return tuple(int(v[i:i + 2], 16) for i in (0, 2, 4))  # type: ignore[return-value]
    except ValueError:
        return (0, 0, 0)


def svg_to_png(path: Path, args) -> Path | None:
    """SVG を PNG 化する（resvg → Chrome の順に試し、透過部分は切り落とす）。"""
    st = path.stat()
    key = hashlib.sha256(
        f"{path.resolve()}\x00{st.st_mtime_ns}\x00{st.st_size}\x00{args.mermaid_width}".encode()
    ).hexdigest()[:16]
    out_dir = CACHE_DIR / "svg"
    out_dir.mkdir(parents=True, exist_ok=True)
    png = out_dir / f"{key}.png"
    if png.exists():
        return png

    if rasterize_svg(path, png, args.mermaid_width):
        return png
    warn(f"SVG を変換できませんでした: {path}")
    return None


def show_image(path: Path, alt: str, args) -> None:
    from PIL import Image

    if path.suffix.lower() == ".svg":
        converted = svg_to_png(path, args)
        if converted is None:
            return
        path = converted

    try:
        with Image.open(path) as im:
            im.load()
            img = im.convert("RGBA")
    except Exception as e:  # noqa: BLE001
        warn(f"画像を開けません: {path} ({e})")
        return

    if args.no_colour:
        print(f"[画像: {alt or path.name}]", flush=True)
        return

    bg = background_colour(args)
    if bg is not None:
        flat = Image.new("RGBA", img.size, bg + (255,))
        flat.alpha_composite(img)
        img = flat.convert("RGB")
    else:
        img = img.convert("RGBA")

    renderer = choose_renderer(args)
    if renderer == "sixel":
        sys.stdout.buffer.write(render_sixel(img, args))
        sys.stdout.buffer.write(b"\n")
        sys.stdout.buffer.flush()
    else:
        max_rows = max(4, shutil.get_terminal_size((100, 40)).lines - 3)
        sys.stdout.write(render_halfblocks(img, args.image_width, args.colours, max_rows))
        sys.stdout.flush()


def choose_renderer(args) -> str:
    if args.renderer != "auto":
        return args.renderer
    return "sixel" if sixel_supported() else "blocks"


# --------------------------------------------------------------------------
# 描画
# --------------------------------------------------------------------------
def render_halfblocks(img, cols: int, colours: str, max_rows: int = 0) -> str:
    """▀/▄ (U+2580/U+2584) と truecolor / 256色エスケープで描画する。"""
    from PIL import Image

    w, h = img.size
    if w <= 0 or h <= 0:
        return ""
    cols = max(1, min(cols, w))
    rows = max(1, round(cols * h / (2 * w)))
    if max_rows and rows > max_rows:
        cols = max(1, int(cols * max_rows / rows))
        rows = max(1, round(cols * h / (2 * w)))
    img = img.resize((cols, rows * 2), Image.LANCZOS)
    px = img.load()
    truecolor = colours == "truecolor"

    def esc(rgb: tuple[int, int, int], bg: bool) -> str:
        r, g, b = rgb
        if truecolor:
            return f"\x1b[{48 if bg else 38};2;{r};{g};{b}m"
        q = lambda v: 0 if v < 48 else 1 if v < 115 else (v - 35) // 40  # noqa: E731
        idx = 16 + 36 * q(r) + 6 * q(g) + q(b)
        if abs(r - g) < 10 and abs(g - b) < 10:
            avg = (r + g + b) // 3
            idx = 16 if avg < 8 else 231 if avg > 238 else 232 + min(23, max(0, (avg - 8) // 10))
        return f"\x1b[{48 if bg else 38};5;{idx}m"

    lines: list[str] = []
    for y in range(rows):
        cur_fg = cur_bg = None
        parts: list[str] = []
        for x in range(cols):
            top = px[x, 2 * y]
            bot = px[x, 2 * y + 1]
            t_op = len(top) < 4 or top[3] >= 128
            b_op = len(bot) < 4 or bot[3] >= 128
            if t_op:
                if cur_fg != top[:3]:
                    parts.append(esc(top[:3], False))
                    cur_fg = top[:3]
                if b_op and cur_bg != bot[:3]:
                    parts.append(esc(bot[:3], True))
                    cur_bg = bot[:3]
                elif not b_op and cur_bg is not None:
                    parts.append("\x1b[49m")
                    cur_bg = None
                parts.append("\u2580")
            elif b_op:
                if cur_fg != bot[:3]:
                    parts.append(esc(bot[:3], False))
                    cur_fg = bot[:3]
                if cur_bg is not None:
                    parts.append("\x1b[49m")
                    cur_bg = None
                parts.append("\u2584")
            else:
                if cur_bg is not None:
                    parts.append("\x1b[49m")
                    cur_bg = None
                parts.append(" ")
        parts.append("\x1b[0m\n")
        lines.append("".join(parts))
    return "".join(lines)


def _sixel_rle(chars: bytes) -> bytes:
    """同じ文字の連続を !<count><char> に圧縮する。"""
    return re.sub(
        rb"(.)\1{3,}",
        lambda m: b"!" + str(len(m.group(0))).encode() + m.group(0)[:1],
        chars,
        flags=re.S,
    )


def sixel_target_size(img, args) -> tuple[int, int]:
    """Sixel で表示する画像の (幅px, 高さpx) を求める。"""
    cell_w, cell_h = cell_pixels()
    target_w = max(8, int(args.image_width * cell_w))
    if args.pixel_scale and args.pixel_scale != 1.0:
        target_w = int(target_w * args.pixel_scale)
    window = probe_terminal()["window"]
    if window:
        target_w = min(target_w, int(window[0]))  # 端末幅を超えない

    w, h = img.size
    if w <= 0 or h <= 0:
        return target_w, 1
    rows = shutil.get_terminal_size((100, 40)).lines
    target_h = max(6, (rows - 3) * cell_h)  # 画面からはみ出さない高さ
    scale = min(target_w / w, target_h / h)
    if scale > 1.0:
        # 小さい画像は端末幅まで拡大する（最大3倍まで。--no-upscale で無効化）
        scale = min(scale, 3.0) if args.upscale else 1.0
    return max(1, int(w * scale)), max(1, int(h * scale))


def render_sixel(img, args) -> bytes:
    """Pillow で量子化して Sixel を生成する（外部コマンド不要）。"""
    from PIL import Image

    tw, th = sixel_target_size(img, args)
    if (tw, th) != img.size:
        img = img.resize((tw, th), Image.LANCZOS)
    if img.mode != "RGB":
        img = img.convert("RGB")

    colors = max(2, min(args.image_colours, 256))
    q = img.quantize(colors=colors, method=Image.Quantize.MEDIANCUT, dither=Image.Dither.NONE)
    W, H = q.size
    data = q.tobytes()
    pal = q.getpalette() or []

    tables: dict[int, bytes] = {}

    def table(c: int) -> bytes:
        t = tables.get(c)
        if t is None:
            t = bytes(1 if i == c else 0 for i in range(256))
            tables[c] = t
        return t

    out: list[bytes] = [b"\x1bP0;1;0q", f'"1;1;{W};{H}'.encode()]
    empty = bytes(W)
    for band in range(0, H, 6):
        rows = []
        for dy in range(6):
            y = band + dy
            rows.append(data[y * W:(y + 1) * W] if y < H else empty)
        used = set()
        for r in rows:
            used.update(r)
        for c in sorted(used):
            t = table(c)
            acc = 0
            for i, r in enumerate(rows):
                acc += int.from_bytes(r.translate(t), "big") << i
            bm = acc.to_bytes(W, "big")
            base = 3 * c
            if base + 2 < len(pal):
                r_, g_, b_ = pal[base], pal[base + 1], pal[base + 2]
            else:
                r_ = g_ = b_ = 0
            out.append(f"#{c};2;{r_};{g_};{b_}".encode())
            out.append(_sixel_rle(bm.translate(SIXEL_TRANSLATE)))
            out.append(b"$")
        out.append(b"-")
    out.append(b"\x1b\\")
    return b"".join(out)


# --------------------------------------------------------------------------
def main() -> None:
    cols = shutil.get_terminal_size((100, 40)).columns
    ap = argparse.ArgumentParser(prog="mdview", description="mdcat + 端末内画像/Mermaid 描画")
    ap.add_argument("-V", "--version", action="version", version=f"mdview {VERSION}")
    ap.add_argument("files", nargs="*", default=["-"], metavar="FILES",
                    help="Markdown ファイル ('-' で標準入力)")
    ap.add_argument("-w", "--width", type=int, default=min(cols, 120),
                    help="テキストの最大桁数 (default: %(default)s)")
    ap.add_argument("-i", "--image-width", type=int, default=min(cols - 2, 200),
                    help="画像の横幅 (端末桁数, default: 端末幅いっぱい)")
    ap.add_argument("-r", "--renderer", choices=["auto", "sixel", "blocks"], default="auto",
                    help="画像の描画方式 (default: 端末を自動判定)")
    ap.add_argument("--colours", choices=["truecolor", "256"], default="truecolor",
                    help="blocks 描画時の色数")
    ap.add_argument("--image-colours", type=int, default=256, help="sixel 描画時の色数")
    ap.add_argument("--image-bg", default="auto", metavar="auto|none|#RRGGBB",
                    help="透過画像の背景 (default: 端末に合わせる)")
    ap.add_argument("--pixel-scale", type=float, default=1.0,
                    help="端末のセルサイズが取得できない場合の倍率 (HiDPI なら 2)")
    ap.add_argument("--upscale", action=argparse.BooleanOptionalAction, default=True,
                    help="端末幅より小さい画像を拡大する (default: 有効, 最大3倍)")
    ap.add_argument("--light", dest="light_background", action="store_true",
                    help="明るい背景の端末として扱う")
    ap.add_argument("-c", "--no-colour", action="store_true", help="色・画像を無効化")
    ap.add_argument("--mermaid-engine", choices=["auto", "pele", "mmdc"], default="auto",
                    help="Mermaid の描画エンジン (default: Pele)")
    ap.add_argument("--mermaid-theme", default="auto",
                    choices=["auto", "default", "dark", "neutral", "forest"])
    ap.add_argument("--mermaid-config", default="", help="mermaid-cli 用の設定 JSON ファイル")
    ap.add_argument("--mermaid-width", type=int, default=2048,
                    help="Mermaid をラスタライズする幅(px, default: %(default)s)")
    ap.add_argument("--mermaid-timeout", type=float, default=90.0)
    ap.add_argument("--check", action="store_true", help="端末の対応状況を表示して終了")
    ap.add_argument("--refresh", action="store_true", help="端末判定をやり直す")
    args = ap.parse_args()

    if not args.light_background:
        fgbg = os.environ.get("COLORFGBG", "")
        if fgbg:
            try:
                args.light_background = int(fgbg.split(";")[-1]) >= 8
            except ValueError:
                pass

    if args.check:
        sixel = sixel_supported(refresh=args.refresh)
        cw, ch = cell_pixels()
        window = probe_terminal()["window"]
        helper = pele_helper()
        print(f"mdcat          : {shutil.which('mdcat') or '見つかりません'}")
        print(f"pele           : {helper or '見つかりません'}")
        print(f"resvg          : {find_resvg() or '見つかりません'}")
        print(f"mmdc           : {shutil.which('mmdc') or '見つかりません'}")
        print(f"chrome         : {find_chrome() or '見つかりません'}")
        print(f"TERM           : {os.environ.get('TERM', '')}")
        print(f"columns        : {cols}")
        print(f"cell pixels    : {cw}x{ch}")
        print(f"window pixels  : {window or '不明'}")
        print(f"sixel support  : {'yes' if sixel else 'no'}")
        if sixel:
            print(f"image width    : {args.image_width} cols"
                  f" (~{args.image_width * cw} px)")
        else:
            print(f"image width    : {args.image_width} cols")
        print(f"renderer       : {choose_renderer(args)}")
        return

    if not shutil.which("mdcat"):
        warn("mdcat が見つかりません (PATH を確認してください)")

    for name in args.files or ["-"]:
        if name == "-":
            process_document(sys.stdin.read(), Path.cwd(), args)
        else:
            p = Path(name)
            if not p.exists():
                die(f"ファイルがありません: {name}")
            process_document(p.read_text(encoding="utf-8", errors="replace"),
                             p.resolve().parent, args)


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        os._exit(0)
